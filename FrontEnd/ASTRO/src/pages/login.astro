---
import { getUsuario } from '../lib/auth';

// Si ya tiene sesión activa, lo mandamos directo al dashboard
const cookie = Astro.request.headers.get('cookie');
const usuario = await getUsuario(cookie);
if (usuario) {
  return Astro.redirect('/dashboard');
}
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>Iniciar sesión — ServiTécnico</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap"
    rel="stylesheet"
  />
</head>
<body>

  <div class="pantalla">

    <!-- Panel izquierdo — identidad -->
    <div class="panel-marca">
      <div class="marca-contenido">
        <span class="marca-icono">⚙</span>
        <h1 class="marca-nombre">ServiTécnico</h1>
        <p class="marca-desc">
          Sistema de gestión de órdenes de servicio técnico.
          Controla clientes, equipos y técnicos desde un solo lugar.
        </p>
        <ul class="marca-features">
          <li>Órdenes con trazabilidad de estados</li>
          <li>Asignación de técnicos activos</li>
          <li>Historial y evidencias por equipo</li>
        </ul>
      </div>
    </div>

    <!-- Panel derecho — formulario -->
    <div class="panel-form">
      <div class="form-wrapper">

        <div class="form-header">
          <h2>Bienvenido</h2>
          <p>Ingresa tus credenciales para continuar</p>
        </div>

        <div id="alerta" class="alerta alerta-oculta" role="alert"></div>

        <form id="form-login" novalidate>

          <div class="campo">
            <label for="correo">Correo electrónico</label>
            <input
              id="correo"
              name="correo"
              type="email"
              placeholder="usuario@ejemplo.com"
              autocomplete="email"
              required
            />
            <span class="campo-error" id="error-correo"></span>
          </div>

          <div class="campo">
            <label for="password">Contraseña</label>
            <div class="input-password">
              <input
                id="password"
                name="password"
                type="password"
                placeholder="••••••••"
                autocomplete="current-password"
                required
              />
              <button type="button" id="toggle-pass" aria-label="Mostrar contraseña">
                👁
              </button>
            </div>
            <span class="campo-error" id="error-password"></span>
          </div>

          <button type="submit" class="btn-submit" id="btn-submit">
            <span id="btn-texto">Iniciar sesión</span>
            <span id="btn-spinner" class="spinner oculto"></span>
          </button>

        </form>

      </div>
    </div>

  </div>

  <script>
    const form      = document.getElementById('form-login') as HTMLFormElement;
    const alerta    = document.getElementById('alerta')!;
    const btnTexto  = document.getElementById('btn-texto')!;
    const btnSpinner= document.getElementById('btn-spinner')!;
    const btnSubmit = document.getElementById('btn-submit') as HTMLButtonElement;
    const togglePass= document.getElementById('toggle-pass')!;
    const inputPass = document.getElementById('password') as HTMLInputElement;

    // Mostrar / ocultar contraseña
    togglePass.addEventListener('click', () => {
      const visible = inputPass.type === 'text';
      inputPass.type = visible ? 'password' : 'text';
      togglePass.textContent = visible ? '👁' : '🙈';
    });

    // Limpiar error inline de un campo al escribir
    form.querySelectorAll('input').forEach(input => {
      input.addEventListener('input', () => {
        const errorEl = document.getElementById(`error-${input.name}`);
        if (errorEl) errorEl.textContent = '';
        input.classList.remove('invalido');
      });
    });

    function mostrarAlerta(msg: string, tipo: 'error' | 'ok') {
      alerta.textContent = msg;
      alerta.className = `alerta alerta-${tipo}`;
    }

    function ocultarAlerta() {
      alerta.className = 'alerta alerta-oculta';
    }

    function setCargando(cargando: boolean) {
      btnSubmit.disabled = cargando;
      btnTexto.textContent = cargando ? 'Verificando...' : 'Iniciar sesión';
      btnSpinner.classList.toggle('oculto', !cargando);
    }

    function validar(correo: string, password: string): boolean {
      let ok = true;

      if (!correo) {
        (document.getElementById('error-correo')!).textContent = 'El correo es obligatorio';
        (document.getElementById('correo') as HTMLInputElement).classList.add('invalido');
        ok = false;
      } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(correo)) {
        (document.getElementById('error-correo')!).textContent = 'Correo no válido';
        (document.getElementById('correo') as HTMLInputElement).classList.add('invalido');
        ok = false;
      }

      if (!password) {
        (document.getElementById('error-password')!).textContent = 'La contraseña es obligatoria';
        inputPass.classList.add('invalido');
        ok = false;
      }

      return ok;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      ocultarAlerta();

      const correo   = (form.correo as HTMLInputElement).value.trim();
      const password = (form.password as HTMLInputElement).value;

      if (!validar(correo, password)) return;

      setCargando(true);

      try {
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ correo, password }),
          credentials: 'include',   // importante: recibe la cookie JWT
        });

        const data = await res.json();

        if (res.ok) {
          mostrarAlerta('Ingreso correcto, redirigiendo...', 'ok');
          window.location.href = '/dashboard';
        } else {
          mostrarAlerta(data.error ?? 'Credenciales incorrectas', 'error');
        }
      } catch {
        mostrarAlerta('No se pudo conectar con el servidor. Verifica que el backend esté activo.', 'error');
      } finally {
        setCargando(false);
      }
    });
  </script>

</body>
</html>

<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Inter', system-ui, sans-serif;
    height: 100vh;
    overflow: hidden;
  }

  /* ── LAYOUT DOS PANELES ── */
  .pantalla {
    display: flex;
    height: 100vh;
  }

  /* ── PANEL IZQUIERDO ── */
  .panel-marca {
    width: 42%;
    background: #1e2a3a;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48px;
  }

  .marca-contenido {
    max-width: 340px;
  }

  .marca-icono {
    font-size: 36px;
    display: block;
    margin-bottom: 16px;
  }

  .marca-nombre {
    font-size: 28px;
    font-weight: 600;
    color: #e2e8f0;
    letter-spacing: -0.02em;
    margin-bottom: 14px;
  }

  .marca-desc {
    font-size: 15px;
    color: #94a3b8;
    line-height: 1.65;
    margin-bottom: 28px;
  }

  .marca-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .marca-features li {
    font-size: 13px;
    color: #64748b;
    padding-left: 18px;
    position: relative;
  }

  .marca-features li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: #2563eb;
    font-weight: 600;
  }

  /* ── PANEL DERECHO ── */
  .panel-form {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f1f5f9;
    padding: 32px;
  }

  .form-wrapper {
    width: 100%;
    max-width: 380px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 36px 32px;
  }

  .form-header {
    margin-bottom: 24px;
  }

  .form-header h2 {
    font-size: 22px;
    font-weight: 600;
    color: #1e293b;
    margin-bottom: 4px;
  }

  .form-header p {
    font-size: 14px;
    color: #64748b;
  }

  /* ── ALERTA ── */
  .alerta {
    padding: 10px 14px;
    border-radius: 6px;
    font-size: 14px;
    margin-bottom: 18px;
  }

  .alerta-oculta { display: none; }

  .alerta-error {
    background: #fee2e2;
    border: 1px solid #fca5a5;
    color: #b91c1c;
  }

  .alerta-ok {
    background: #dcfce7;
    border: 1px solid #86efac;
    color: #15803d;
  }

  /* ── CAMPOS ── */
  .campo {
    display: flex;
    flex-direction: column;
    gap: 5px;
    margin-bottom: 16px;
  }

  .campo label {
    font-size: 13px;
    font-weight: 500;
    color: #374151;
  }

  .campo input {
    padding: 9px 12px;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    font-size: 14px;
    color: #1e293b;
    background: #ffffff;
    transition: border-color 0.15s, box-shadow 0.15s;
    font-family: inherit;
    width: 100%;
  }

  .campo input:focus {
    outline: none;
    border-color: #2563eb;
    box-shadow: 0 0 0 3px #eff6ff;
  }

  .campo input.invalido {
    border-color: #ef4444;
    box-shadow: 0 0 0 3px #fee2e2;
  }

  .campo-error {
    font-size: 12px;
    color: #ef4444;
    min-height: 16px;
  }

  /* ── INPUT PASSWORD con botón ── */
  .input-password {
    position: relative;
  }

  .input-password input {
    padding-right: 40px;
  }

  .input-password button {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    cursor: pointer;
    font-size: 16px;
    color: #94a3b8;
    line-height: 1;
  }

  /* ── BOTÓN SUBMIT ── */
  .btn-submit {
    width: 100%;
    padding: 10px;
    background: #2563eb;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    font-size: 15px;
    font-weight: 500;
    cursor: pointer;
    margin-top: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: opacity 0.15s;
    font-family: inherit;
  }

  .btn-submit:hover:not(:disabled) { opacity: 0.88; }
  .btn-submit:disabled { opacity: 0.6; cursor: not-allowed; }

  /* ── SPINNER ── */
  .spinner {
    width: 15px;
    height: 15px;
    border: 2px solid rgba(255,255,255,0.3);
    border-top-color: #ffffff;
    border-radius: 50%;
    animation: girar 0.7s linear infinite;
  }

  .oculto { display: none; }

  @keyframes girar {
    to { transform: rotate(360deg); }
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 640px) {
    .panel-marca { display: none; }
    .panel-form { padding: 20px; }
  }
</style>