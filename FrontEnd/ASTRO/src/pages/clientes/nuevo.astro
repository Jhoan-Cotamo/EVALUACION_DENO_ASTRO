---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout titulo="Nuevo cliente">

  <div class="card" style="max-width:520px;">
    <h2 class="form-titulo">Registrar cliente</h2>

    <div id="alerta" class="alerta-oculta"></div>

    <form id="form" novalidate>
      <div class="campos">
        <div class="campo">
          <label for="nombre_completo">Nombre completo *</label>
          <input id="nombre_completo" name="nombre_completo" type="text" required />
        </div>
        <div class="campo">
          <label for="documento">Documento *</label>
          <input id="documento" name="documento" type="text" required />
        </div>
        <div class="campo">
          <label for="telefono">Teléfono</label>
          <input id="telefono" name="telefono" type="text" />
        </div>
        <div class="campo">
          <label for="correo">Correo electrónico *</label>
          <input id="correo" name="correo" type="email" required />
        </div>
      </div>

      <div class="form-footer">
        <a href="/clientes" class="btn btn-ghost">Cancelar</a>
        <button type="submit" class="btn btn-primary" id="btn-submit">Guardar cliente</button>
      </div>
    </form>
  </div>

</DashboardLayout>

<script>
  const form = document.getElementById('form') as HTMLFormElement;
  const alerta = document.getElementById('alerta')!;
  const btn = document.getElementById('btn-submit') as HTMLButtonElement;

  function mostrar(msg: string, ok: boolean) {
    alerta.textContent = msg;
    alerta.className = ok ? 'alerta-ok' : 'alerta-error';
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    btn.disabled = true;
    btn.textContent = 'Guardando…';

    const datos = {
      nombre_completo: (form.nombre_completo as HTMLInputElement).value.trim(),
      documento:       (form.documento as HTMLInputElement).value.trim(),
      telefono:        (form.telefono as HTMLInputElement).value.trim() || undefined,
      correo:          (form.correo as HTMLInputElement).value.trim(),
    };

    if (!datos.nombre_completo || !datos.documento || !datos.correo) {
      mostrar('Por favor completa todos los campos obligatorios.', false);
      btn.disabled = false;
      btn.textContent = 'Guardar cliente';
      return;
    }

    const res = await fetch('/api/proxy/clientes', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(datos),
    });

    const data = await res.json();

    if (res.ok) {
      mostrar('Cliente registrado exitosamente. Redirigiendo…', true);
      setTimeout(() => window.location.href = '/clientes', 1200);
    } else {
      mostrar(data.error ?? 'Error al registrar cliente.', false);
      btn.disabled = false;
      btn.textContent = 'Guardar cliente';
    }
  });
</script>

<style>
  .form-titulo { font-size: 16px; font-weight: 600; color: #1e293b; margin-bottom: 20px; }
  .campos { display: flex; flex-direction: column; gap: 14px; margin-bottom: 24px; }
  .form-footer { display: flex; gap: 10px; justify-content: flex-end; }
  .alerta-ok, .alerta-error {
    padding: 10px 14px; border-radius: 6px; font-size: 14px; margin-bottom: 16px;
  }
  .alerta-ok    { background:#dcfce7; border:1px solid #86efac; color:#15803d; }
  .alerta-error { background:#fee2e2; border:1px solid #fca5a5; color:#b91c1c; }
  .alerta-oculta { display: none; }
</style>